# ==============================================================================
# ResQNet — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Network Operating Mode
# ------------------------------------------------------------------------------
# Production flag: When true, asserts strict security and enforces RESQNET_MODE=real
RESQNET_PRODUCTION=true

# Operating Mode: MUST BE "real" in production (spawns 5 independent OS node processes
# exchanging real AODV datagrams over UDP sockets).
# Set to "simulation" only for local developer testing.
RESQNET_MODE=real

# Host interface and port for the FastAPI backend server
RESQNET_HOST=0.0.0.0
RESQNET_PORT=8000

# Node configuration profile path
# Single Linux VPS / Local: configs/localhost_nodes.json
# Multi-machine LAN:       configs/lan_two_laptops.json
RESQNET_CONFIG=configs/localhost_nodes.json

# Comma-separated list of nodes managed locally by this host (default: all nodes)
# Set to "A,B,C,D" on Laptop 1 if Laptop 2 manages Hospital node "H"
# RESQNET_MANAGED_NODES=A,B,C,D,H

# Inbound UDP Event Bridge listener
RESQNET_EVENT_BIND_HOST=0.0.0.0
RESQNET_EVENT_PORT=50099

# ------------------------------------------------------------------------------
# 2. Production Security & Authorization Credentials
# ------------------------------------------------------------------------------
# Secret administrative key required to trigger node failures, link breaks,
# runtime mode switches, and simulation resets.
# Required in production. Cannot be empty or default template string.
RESQNET_ADMIN_KEY=change_me_to_a_secure_admin_token_98765

# Dedicated hospital clinician credential required to submit medical triage
# instructions back across the network to field rescue units.
# Required in production. Cannot be empty or identical to RESQNET_ADMIN_KEY.
RESQNET_HOSPITAL_KEY=change_me_to_a_secure_clinician_token_43210

# Permitted CORS origins for browser REST clients (comma-separated).
# In production with a custom domain or VPS public IP, specify your full URL:
# e.g. https://resqnet.example.com,http://203.0.113.10
RESQNET_CORS_ORIGINS=https://resqnet.example.com,http://localhost

# Enforce strict origin checking on WebSocket connections (true | false)
# Prevents Cross-Site WebSocket Hijacking from unauthorized external domains.
RESQNET_STRICT_WS_ORIGIN=true

# Sliding-window rate limit for emergency SOS requests (per minute per client IP)
RESQNET_RATE_LIMIT_SOS_PER_MIN=60

# ------------------------------------------------------------------------------
# 3. Two-Laptop Physical LAN Deployment (Optional)
# ------------------------------------------------------------------------------
# Used when RESQNET_CONFIG=configs/lan_two_laptops.json
LAPTOP_1_IP=192.168.1.100
LAPTOP_2_IP=192.168.1.105

# ------------------------------------------------------------------------------
# 4. Frontend Client Notes
# ------------------------------------------------------------------------------
# The React dashboard auto-detects protocol (http/https -> ws/wss) and host.
# Secrets (Admin Key and Hospital Key) are entered securely by operators in the UI
# and stored in browser localStorage. They are NEVER baked into Vite bundle assets.
